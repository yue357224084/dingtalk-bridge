# ===== 钉钉应用凭证 =====
# 企业内部应用（开发者后台创建），机器人能力需开启「Stream 模式」并发布
DD_APP_CLIENT_ID=dingxxxxxxxxxxxxxxx
DD_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 本机 OpenChamber 插件接口（plugin/dingtalk-bridge.ts 提供）=====
# 注意：这里的地址是「运行 OpenChamber 的那台机器」的地址与端口
DD_BRIDGE_ASK_URL=http://192.168.1.10:7839/ask
DD_BRIDGE_NEW_URL=http://192.168.1.10:7839/newsession
# 与插件 .env 中的 DD_ASK_TOKEN 保持一致（跨主机时必填；随机 32 位 hex 即可）
DD_ASK_TOKEN=0123456789abcdef0123456789abcdef

# ===== 会话归属 =====
# 新建的 OpenCode 会话落在哪个目录（该路径是 OpenChamber 主机上的路径，不是本服务所在主机的路径）
DD_SESSION_DIR=D:\yu_work

# ===== 回复与超时 =====
DD_ASK_TIMEOUT=120
DD_REPLY_TITLE=OpenCode 答复
DD_REPLY_MAX_CHARS=15000

# ===== 运行参数 =====
# 单实例锁端口（本机回环，防重复实例抢消息）
DD_LOCK_PORT=7838
# 记录原始入站消息 JSON（排查用，含群/用户标识，注意日志保密）
DD_LOG_RAW=0
