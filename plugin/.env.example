# 放到 OpenCode 插件目录（本机为 ~/.config/opencode/plugins/.env 或
# C:\Users\<用户>\.config\opencode\plugins\.env）。两个插件共用此文件。

# ===== 插件一：会话总结发送（dingtalk.ts，命令 /dd）=====
# 群自定义机器人的 webhook 地址
DD_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxxxxxxxxxxxxxxx
DD_TITLE=会话总结
# DD_DRY_RUN=1          # 只演练不发送（联调）
# DD_AT_ALL=1           # 发送时 @所有人（默认关闭）
# DD_MAX_CHARS=18000    # 正文最大字符数，超出截断
# DD_RECEIPT=off        # 关闭会话内合成回执（默认 synthetic）
# DD_DEBUG=1            # 输出诊断日志

# ===== 插件二：桥接接口（dingtalk-bridge.ts）=====
# 监听地址：仅同机使用可留 127.0.0.1；跨主机桥接需 0.0.0.0（或本机局域网 IP）
# DD_BIND=127.0.0.1
# DD_BRIDGE_PORT=7839
# 访问令牌（与 bridge/config.env 的 DD_ASK_TOKEN 一致；跨主机时必须设置）
# DD_ASK_TOKEN=0123456789abcdef0123456789abcdef

# ===== 通用 =====
# 关闭占位符还原（默认开启：把 [IPV4_n]/[SECRET_n] 等还原为真值后再外发）
# DD_REHYDRATE=0
# sensitive-filter 映射目录（默认系统临时目录）
# SF_MAP_DIR=
